# Copia este fichero a .env y ajusta los valores.
# NUNCA subas el .env real a un repositorio: contiene la clave de firma de sesión.

# --- Base de datos (PostgreSQL) ---
# En Railway se inyecta automáticamente al enlazar el servicio de Postgres.
# En local, apunta a tu propia base de datos o a la de Railway.
DATABASE_URL="postgresql://usuario:contrasena@localhost:5432/crm?schema=public"

# --- Sesión ---
# Clave de firma de los JWT. OBLIGATORIA y larga.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
JWT_EXPIRES_IN="7d"

# --- Servidor ---
# En Railway el puerto lo inyecta la plataforma; no hace falta fijarlo.
PORT=4000
NODE_ENV=development

# Origen permitido del frontend (separa varios con comas).
# Si la API sirve también la interfaz, es el mismo dominio.
CORS_ORIGIN="http://localhost:5173"

# --- Seguridad ---
# Pon "false" en cuanto hayas creado tu cuenta: impide que nadie más se registre.
# Imprescindible si el CRM está accesible desde internet.
ALLOW_REGISTRATION=true

# Pon "true" solo si sirves realmente por HTTPS (activa HSTS y upgrade-insecure-requests).
# En Railway debe ser "true"; en local con http:// debe ser "false".
HTTPS_ENABLED=false
